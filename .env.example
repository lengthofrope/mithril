# Deploy Token
# This token is used to authenticate deployment requests
DEPLOY_TOKEN=your-secure-token-here

# Laravel Application Configuration
APP_NAME="Mithril"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teamlead_dashboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ATTACHMENT_MAX_STORAGE_MB=1024

# Microsoft Entra ID (Azure AD)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# Jira Cloud (Atlassian OAuth 2.0 3LO)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI="${APP_URL}/auth/jira/callback"

# Meetings — Recording
MEETING_RECORDING_ENABLED=true           # Options: true, false — disables upload/recording when false
MEETING_RECORDING_DISK=local              # Options: local, public, s3
MEETING_RECORDING_MAX_MB=500
MEETING_AUTO_START_ON_RECORD=true         # Options: true, false

# Meetings — Transcription (see docker/speech/ for service setup)
MEETING_TRANSCRIPTION_ENABLED=true        # Options: true, false — disables auto-transcription when false (manual paste still works)
MEETING_AUTO_TRANSCRIBE=true              # Options: true, false

# Meetings — Speaker Diarization
MEETING_DIARIZATION_ENABLED=false         # Options: true, false

# Meetings — Speech Service
UNIFIED_SPEECH_BASE_URL=http://localhost:8090
SPEECH_AUTH_TOKEN=                               # Must match SPEECH_AUTH_TOKEN in docker/speech/.env

# AI Provider (used for meeting extraction and future AI features)
AI_ENABLED=true                              # Options: true, false — disables all AI features when false
AI_PROVIDER=anthropic                        # Options: openai, openrouter, anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5                    # OpenAI: gpt-4o-mini, gpt-4o | OpenRouter: openai/gpt-4o-mini | Anthropic: claude-haiku-4-5, claude-sonnet-4-6
