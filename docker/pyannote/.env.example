# Host port to expose the pyannote diarization server on
PYANNOTE_PORT=8081

# HuggingFace access token (REQUIRED — model is gated)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the model licenses:
#   - https://huggingface.co/pyannote/speaker-diarization-community-1
#   - https://huggingface.co/pyannote/segmentation-3.0
HUGGINGFACE_TOKEN=

# Whisper model size for timestamped transcription (used internally for merging)
# Options: tiny, base, small, medium, large-v3-turbo, large-v3
WHISPER_MODEL_SIZE=large-v3-turbo
