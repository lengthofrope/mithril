# Host port to expose the speech service on
SPEECH_PORT=8090

# Whisper model size for transcription
# Options: tiny, base, small, medium, large-v3-turbo, large-v3
# Use 'tiny' for development (fast, low quality), 'large-v3-turbo' for production
WHISPER_MODEL=large-v3-turbo

# GPU support: uncomment the line below on hosts with NVIDIA GPU + Container Toolkit
# This tells Docker Compose to merge the GPU override file automatically.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# HuggingFace token for pyannote speaker diarization (optional)
# When set, diarization uses pyannote (higher quality, requires gated model access).
# When empty/absent, diarization uses the default engine (no token needed).
# Get a token at: https://huggingface.co/settings/tokens
# You must also accept the model license: https://huggingface.co/pyannote/speaker-diarization-3.1
# HUGGINGFACE_TOKEN=
